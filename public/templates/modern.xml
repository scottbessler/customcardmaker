<!-- Modern: our one standard look (MTG Nexus's "Normal"). It also stands in for what used
     to be the classic, borderless and Nexus looks. Places are in card-width units (the card
     is 100 wide, 140 tall), measured off a real card: the art box is the top half and the
     text box the bottom third, as a printed card has them. The stylesheet says how each
     part looks. The P/T badge has no size of its own: it is as big as its value, anchored by
     its bottom-right corner. -->
<template id="modern" label="Modern" frame="modern">
  <plate role="name" x="4.6" y="6.9" w="90.8" h="7.9">
    <field name="name"/>
    <field name="mana_cost"/>
  </plate>
  <art x="7.7" y="15.5" w="84.6" h="62.1"/>
  <plate role="type" x="4.6" y="77.7" w="90.8" h="8.4">
    <field name="type_line"/>
  </plate>
  <box x="6.8" y="86.1" w="86.4" h="43.4">
    <field name="rules_text"/>
    <field name="flavor_text"/>
  </box>
  <stat x="94.4" y="133.6">
    <field name="power_toughness"/>
  </stat>
</template>
