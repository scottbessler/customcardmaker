  </plate>
  <plate role="type" x="5" y="42.5" w="90" h="6.4">
    <field name="type_line"/>
  </plate>
  <box x="5" y="49.5" w="90" h="18">
    <field name="rules_text"/>
  </box>
  <art x="5" y="73" w="90" h="28" face="half"/>
  <plate role="name" x="5" y="103" w="90" h="7.2" face="half">
    <field name="name"/>
    <field name="mana_cost"/>
  </plate>
  <plate role="type" x="5" y="111" w="90" h="6.4" face="half">
    <field name="type_line"/>
  </plate>
  <box x="5" y="118" w="90" h="17.5" face="half">
    <field name="rules_text"/>
  </box>
