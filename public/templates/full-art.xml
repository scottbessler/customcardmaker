<!-- Full art: the picture is the whole card, and the plates and text box float on it. The art
     is the card itself; the text box sits low, over the picture's own foot. -->
<template id="full-art" label="Full art" frame="full-art">
  <plate role="name" x="5" y="4.4" w="90" h="7.4">
    <field name="name"/>
    <field name="mana_cost"/>
  </plate>
  <art x="0" y="0" w="100" h="139.68"/>
  <plate role="type" x="5" y="95.88" w="90" h="6.6">
    <field name="type_line"/>
  </plate>
  <box x="5" y="103.68" w="90" h="27">
    <field name="rules_text"/>
    <field name="flavor_text"/>
  </box>
  <stat x="96.6" y="137.08">
    <field name="power_toughness"/>
  </stat>
</template>
