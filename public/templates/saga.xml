<!-- Saga: chapters down the left beside their numerals, the art on the right, the type line
     across the foot. It has nowhere to draw a stat. -->
<template id="saga" label="Saga" excludes="power_toughness loyalty defense" frame="inherit">
  <plate role="name" x="4.6" y="5" w="90.8" h="9.4">
    <field name="name"/>
    <field name="mana_cost"/>
  </plate>
  <art x="50" y="15" w="42.5" h="102"/>
  <box x="4.5" y="15" w="45.5" h="102.5">
    <field name="rules_text" as="chapters"/>
  </box>
  <plate role="type" x="4.6" y="117.8" w="90.8" h="9">
    <field name="type_line"/>
  </plate>
</template>
