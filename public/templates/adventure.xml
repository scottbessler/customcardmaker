  <plate role="name" x="4.6" y="6.9" w="90.8" h="7.9">
    <field name="name"/>
    <field name="mana_cost"/>
  </plate>
  <art x="7.7" y="15.5" w="84.6" h="55"/>
  <plate role="type" x="4.6" y="71.5" w="90.8" h="8.4">
    <field name="type_line"/>
  </plate>
  <box x="6.8" y="80.5" w="42" h="47.5">
    <field name="rules_text"/>
    <field name="flavor_text"/>
  </box>
  <plate role="name" x="51" y="80.5" w="44" h="7.9" face="half">
    <field name="name"/>
    <field name="mana_cost"/>
  </plate>
  <box x="51" y="89" w="44" h="39" face="half">
    <field name="rules_text"/>
  </box>
  <stat x="94.4" y="133.6">
    <field name="power_toughness"/>
  </stat>
</template>
