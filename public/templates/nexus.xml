<!-- Nexus: the normal card as MTG Nexus draws it, with a tall art box. Places are in card-width
     units, measured off real Nexus cards, so a card drawn natively and a scan of one with our
     text laid over it (the card's picture is a whole card) share this geometry. It wears the
     card's own look, else the set's, for its frame. -->
<template id="nexus" label="Nexus" frame="inherit">
  <plate role="name" x="4.6" y="5.8" w="90.8" h="10">
    <field name="name"/>
    <field name="mana_cost"/>
  </plate>
  <art x="7.7" y="15.5" w="84.6" h="62"/>
  <plate role="type" x="4.6" y="77.8" w="90.8" h="9.6">
    <field name="type_line"/>
  </plate>
  <box x="6.8" y="87.4" w="86.4" h="40.6">
    <field name="rules_text"/>
  </box>
  <stat x="78" y="125" w="16.4" h="8.6">
    <field name="power_toughness"/>
  </stat>
</template>
